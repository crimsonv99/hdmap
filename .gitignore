# Secrets — API keys loaded at runtime by api.mjs. Never commit.
keys.json

# Baker intermediates — big, regenerable. Never commit.
build/
node_modules/
.DS_Store

# Not needed by the hosted city viewer (index.html uses ./tiles):
#  - the single PMTiles archive (regenerable source for the tiles)
#  - the original single-district GeoJSON demo data
data/hanoi.pmtiles
data/lanes.geojson
data/markings.geojson
data/intersections.geojson
data/turn_arrows.geojson
data/buildings.geojson
data/meta.json

# The city map is served from ./tiles (uncompressed MVT) + data/hanoi-meta.json,
# both of which ARE committed so the site runs on GitHub Pages with no server.

# Car marker: only the trimmed image/car.png is served. Keep the big source
# (2000x2000 original + PSD) out of the repo.
image/10382282.png
image/*.psd
